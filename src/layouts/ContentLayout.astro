---
import PageLayout from './PageLayout.astro';
import Prose from '~/components/Prose.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<PageLayout title={title}>
  <!-- 使用 Tailwind Typography 美化渲染后的 Markdown -->
  <!-- 参考: https://docs.astro.build/zh-cn/recipes/tailwind-rendered-markdown/#%E6%93%8D%E4%BD%9C%E6%AD%A5%E9%AA%A4 -->
  <Prose>
    <div transition:name={title}>{title}</div>
    <slot />
  </Prose>
</PageLayout>
